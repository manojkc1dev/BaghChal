# BheedChaal Production Environment Variables Template
# Copy this file to .env and fill in real secrets before deploying.

# Django Security
DEBUG=False
SECRET_KEY=your-production-high-entropy-secret-key-min-50-chars
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost

# CORS & CSRF Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# PostgreSQL Database
POSTGRES_DB=bheedchaal_db
POSTGRES_USER=bheedchaal_admin
POSTGRES_PASSWORD=your_secure_db_password_here
DATABASE_URL=postgres://bheedchaal_admin:your_secure_db_password_here@postgres:5432/bheedchaal_db

# Redis Channel Layer
REDIS_HOST=redis
REDIS_PORT=6379
# Alternatively set full connection URL:
# REDIS_URL=redis://redis:6379/0

# Frontend Environment Variables (Set during Vite build process)
# VITE_API_URL=https://api.yourdomain.com
# VITE_WS_URL=wss://api.yourdomain.com
